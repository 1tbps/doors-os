// Configuração padrão do fastfetch no Doors OS (vale para todos os usuários).
// Quem quiser personalizar cria ~/.config/fastfetch/config.jsonc, que tem prioridade.
// Sem isto o fastfetch não reconhece ID=doors e mostra o logo do Debian (ID_LIKE).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // Porta em arco, gerada por branding/gerar-logo-fastfetch.py (códigos de cor
        // já no arquivo, por isso "file-raw" com largura e altura fixas).
        "type": "file-raw",
        "source": "/usr/share/doors/fastfetch/doors.txt",
        "width": 32,
        "height": 19,
        "padding": {
            "right": 2
        }
    },
    "display": {
        "color": "blue"
    },
    // Com um arquivo de configuração, o fastfetch só mostra os módulos listados aqui
    // (sem esta lista sai só o logo). Mesma lista do padrão do fastfetch.
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages",
        "shell", "display", "de", "wm", "wmtheme", "theme", "icons", "font",
        "cursor", "terminal", "terminalfont", "cpu", "gpu", "memory", "swap",
        "disk", "localip", "battery", "poweradapter", "locale", "break", "colors"
    ]
}
