# Doors OS (GNOME): padrões da extensão de cantos arredondados (doors-gnome-cantos).
# O esquema dela fica dentro da extensão, então o padrão do Doors vai pelo dconf
# (perfil "user" + banco "local"). O Doors Aparência troca a cor da borda.

[org/gnome/shell/extensions/rounded-window-corners-reborn]
# borda de 2 px (padrão do Doors em todos os ambientes); na janela ativa, na cor de destaque (azul do Doors)
border-width=2
# também nos apps do GNOME (libadwaita), para a borda colorida aparecer em todas as janelas
skip-libadwaita-app=false
global-rounded-corner-settings={'padding': <{'left': <uint32 1>, 'right': <uint32 1>, 'top': <uint32 1>, 'bottom': <uint32 1>}>, 'keepRoundedCorners': <{'maximized': <false>, 'fullscreen': <false>}>, 'borderRadius': <uint32 12>, 'smoothing': <0>, 'borderColor': <[0.184, 0.471, 0.710, 1.0]>, 'enabled': <true>}
# sem sombra nas janelas (deixava rastro ao arrastar com janelas gelatinosas)
focused-shadow={'horizontalOffset': 0, 'verticalOffset': 0, 'blurOffset': 0, 'spreadRadius': 0, 'opacity': 0}
unfocused-shadow={'horizontalOffset': 0, 'verticalOffset': 0, 'blurOffset': 0, 'spreadRadius': 0, 'opacity': 0}
# sem a entrada "Rounded Corners Settings" no menu do botão direito da área de trabalho
enable-preferences-entry=false

# Print Screen abre o Flameshot (no lugar da captura do GNOME)
[org/gnome/shell/keybindings]
show-screenshot-ui=@as []

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/doors-flameshot/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/doors-flameshot]
name='Flameshot'
command='flameshot gui'
binding='Print'

# Grade de aplicativos: as pastas padrão do GNOME (Sistema e Utilitários, mesmas listas do
# gnome-shell 48), com os assistentes "Entrar no domínio" e "Pasta do scanner" no começo de Sistema
# (a pasta segue a ordem da lista; 9 por página).
# Com folder-children definido o GNOME não recria as pastas no primeiro login.
[org/gnome/desktop/app-folders]
folder-children=['System', 'Utilities']

[org/gnome/desktop/app-folders/folders/System]
name='X-GNOME-Shell-System.directory'
translate=true
apps=['doors-entrar-dominio.desktop', 'doors-pasta-scanner.desktop', 'nm-connection-editor.desktop', 'org.gnome.DejaDup.desktop', 'org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'im-config.desktop', 'org.gnome.Logs.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.freedesktop.GnomeAbrt.desktop', 'org.gnome.tweaks.desktop', 'org.gnome.Sysprof.desktop', 'org.gnome.SystemMonitor.desktop']

[org/gnome/desktop/app-folders/folders/Utilities]
name='X-GNOME-Shell-Utilities.directory'
translate=true
apps=['org.gnome.Decibels.desktop', 'org.gnome.Connections.desktop', 'org.gnome.Evince.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop']
