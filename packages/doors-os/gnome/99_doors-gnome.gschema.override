# Doors OS: aparência padrão do GNOME (usuários novos). "99_": vem depois do override do calamares-settings-debian (96_).
# Painel único embaixo no estilo do Linux Mint (Dash to Panel + menu ArcMenu com o logo do Doors),
# ícones Doors (elementary-xfce), fontes Noto, botões minimizar/maximizar/fechar e destaque azul.
[org.gnome.desktop.interface]
icon-theme='Doors'
font-name='Noto Sans 11'
document-font-name='Noto Sans 11'
accent-color='blue'

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Noto Sans Bold 11'

# o modo escuro do GNOME usa outro papel de parede (picture-uri-dark): o mesmo do Doors
[org.gnome.desktop.background]
picture-uri-dark='file:///usr/share/images/desktop-base/desktop-background.xml'

[org.gnome.mutter]
center-new-windows=true

[org.gnome.shell]
enabled-extensions=['dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'ubuntu-appindicators@ubuntu.com']
favorite-apps=['calamares-install-debian.desktop', 'chromium.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.doors.Aparencia.desktop']
