# Doors OS: GNOME do jeito do GNOME (barra no topo, visão geral e dock), só com os papéis
# de parede do Doors e as janelas com cantos arredondados e borda colorida (doors-gnome-cantos).
# "99_": vem depois dos outros overrides (calamares-settings-debian 96_, Cinnamon 90_).

# visual padrão do GNOME (o override do Cinnamon troca estes valores para o tema Doors)
[org.gnome.desktop.interface]
gtk-theme='Adwaita'
icon-theme='Adwaita'
accent-color='blue'

# o modo escuro do GNOME usa outro papel de parede (picture-uri-dark): o mesmo do Doors
[org.gnome.desktop.background]
picture-uri-dark='file:///usr/share/images/desktop-base/desktop-background.xml'

[org.gnome.shell]
enabled-extensions=['rounded-window-corners@fxgn', 'info-maquina@doors-os']
favorite-apps=['calamares-install-debian.desktop', 'chromium.desktop', 'org.gnome.Evolution.desktop', 'rhythmbox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'yelp.desktop']
