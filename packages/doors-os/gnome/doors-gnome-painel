#!/bin/sh
# Doors OS (GNOME): ajustes do painel no primeiro login de cada usuário.
# O Dash to Panel reescreve "panel-element-positions" ao iniciar, então o padrão do
# Doors (sem o botão de grade de aplicativos; o menu é o ArcMenu) é aplicado depois.
sleep 3
# fecha a visão geral que o GNOME abre ao entrar
gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
  --method org.freedesktop.DBus.Properties.Set org.gnome.Shell OverviewActive '<false>' >/dev/null 2>&1 || true
F="${XDG_CONFIG_HOME:-$HOME/.config}/doors/gnome-painel"
[ -e "$F" ] && exit 0
E='[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]'
if gsettings set org.gnome.shell.extensions.dash-to-panel panel-element-positions "{\"0\":$E}"; then
  mkdir -p "$(dirname "$F")" && touch "$F"
fi
