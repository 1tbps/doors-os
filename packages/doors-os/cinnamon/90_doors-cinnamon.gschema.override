# Doors OS: aparência padrão do Cinnamon (usuários novos)
# Janelas Greybird (estilo Xubuntu/MX) com contorno azul na janela ativa,
# ícones elementary-xfce e fontes Noto. O painel do Cinnamon já vem embaixo, como no Mint.
[org.cinnamon.desktop.interface]
gtk-theme='Doors'
icon-theme='Doors'
font-name='Noto Sans 10'

[org.cinnamon]
# menu novo (estilo Cinnamon 6.6) no lugar do menu padrão do 6.4
enabled-applets=['panel1:left:0:menu-doors@doors-os', 'panel1:left:1:separator@cinnamon.org', 'panel1:left:2:grouped-window-list@cinnamon.org', 'panel1:right:0:systray@cinnamon.org', 'panel1:right:1:xapp-status@cinnamon.org', 'panel1:right:2:notifications@cinnamon.org', 'panel1:right:3:printers@cinnamon.org', 'panel1:right:4:removable-drives@cinnamon.org', 'panel1:right:5:keyboard@cinnamon.org', 'panel1:right:6:favorites@cinnamon.org', 'panel1:right:7:network@cinnamon.org', 'panel1:right:8:sound@cinnamon.org', 'panel1:right:9:power@cinnamon.org', 'panel1:right:10:calendar@cinnamon.org', 'panel1:right:11:cornerbar@cinnamon.org']
favorite-apps=['chromium.desktop', 'nemo.desktop', 'org.gnome.Terminal.desktop', 'org.doors.Aparencia.desktop', 'cinnamon-settings.desktop']

[org.cinnamon.desktop.wm.preferences]
theme='Doors'
titlebar-font='Noto Sans Bold 10'
button-layout=':minimize,maximize,close'

[org.gnome.desktop.interface]
gtk-theme='Doors'
icon-theme='Doors'
