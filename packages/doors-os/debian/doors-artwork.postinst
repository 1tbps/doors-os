#!/bin/sh
set -e
T=/usr/share/desktop-base/doors-theme
if [ "$1" = configure ]; then
  update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme $T 100
  # na primeira instalação torna o tema Doors o ativo (depois respeita a escolha do admin)
  if [ -z "$2" ]; then
    update-alternatives --set desktop-theme $T
  fi
  # logos do sistema (tela de login do GNOME e outros): Doors no lugar do Debian
  update-alternatives --install /usr/share/images/vendor-logos vendor-logos /usr/share/desktop-base/doors-logos 100
  case "$(readlink -f /etc/alternatives/vendor-logos 2>/dev/null)" in
    ""|/usr/share/desktop-base/debian-logos) update-alternatives --set vendor-logos /usr/share/desktop-base/doors-logos ;;
  esac
  # em atualizações num sistema instalado, regenera o menu do GRUB (fundo pode ter mudado)
  if [ -n "$2" ] && [ -x /usr/sbin/update-grub ] && [ -e /boot/grub/grub.cfg ]; then
    update-grub >/dev/null 2>&1 || true
  fi
fi
# tela de inicialização (Plymouth): troca o tema do Debian pelo do Doors, uma vez
if [ "$1" = configure ] && [ -x /usr/sbin/plymouth-set-default-theme ]; then
  atual=$(/usr/sbin/plymouth-set-default-theme 2>/dev/null || true)
  case "$atual" in
    ""|ceratopsian|debian-theme|emerald|homeworld|futureprototype|moonlight|softwaves|joy|lines|spacefun)
      if /usr/sbin/plymouth-set-default-theme doors 2>/dev/null && [ -x /usr/sbin/update-initramfs ] && ls /boot/initrd.img-* >/dev/null 2>&1; then
        update-initramfs -u -k all >/dev/null 2>&1 || true
      fi;;
  esac
fi
if [ "$1" = configure ] || [ "$1" = triggered ]; then
  /usr/lib/doors/atualizar-papeis-de-parede || true
  gtk-update-icon-cache -q -f /usr/share/icons/Doors 2>/dev/null || true
fi
#DEBHELPER#
