#!/bin/sh
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  # imagens 0.1 desviavam o arquivo com --local; troca pela diversão do pacote
  if dpkg-divert --listpackage /usr/lib/os-release | grep -qx LOCAL; then
    dpkg-divert --local --remove --no-rename /usr/lib/os-release
    rm -f /usr/lib/os-release
  fi
  dpkg-divert --package doors-release --add --rename \
    --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
#DEBHELPER#
