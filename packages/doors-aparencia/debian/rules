#!/usr/bin/make -f
# Build offline: as dependências Rust vêm dos pacotes librust-*-dev do Debian.
export CARGO_HOME = $(CURDIR)/debian/cargo_home

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "debian"\n[source.debian]\ndirectory = "/usr/share/cargo/registry"\n[net]\noffline = true\n' > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo build --release

override_dh_auto_test:
	cargo test --release

override_dh_auto_install:
	install -D -m 755 target/release/doors-aparencia debian/doors-aparencia/usr/bin/doors-aparencia
	install -D -m 644 data/org.doors.Aparencia.desktop debian/doors-aparencia/usr/share/applications/org.doors.Aparencia.desktop
	install -D -m 644 data/org.doors.Aparencia.svg debian/doors-aparencia/usr/share/icons/hicolor/scalable/apps/org.doors.Aparencia.svg

override_dh_auto_clean:
	rm -rf target $(CARGO_HOME) Cargo.lock
