# Configuração central do Doors OS (lida pelos scripts de build)
# Versão da distribuição (os-release, menu de boot, instalador, nome das ISOs)
DOORS_VERSION=0.2
# URL do repositório APT do Doors OS gravada nos sistemas instalados.
# Hospedado no GitHub Pages (repositório público 1tbps/doors-os-apt; só pacotes Doors e chave pública).
DOORS_APT_URL=https://1tbps.github.io/doors-os-apt/
