#!/bin/sh
# Identidade Doors OS em /usr/lib/os-release (desviado para não ser sobrescrito por base-files)
set -e
. /usr/lib/os-release
DEB_VER="$VERSION_ID"
dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<EOT
PRETTY_NAME="Doors OS ${DOORS_VERSION:-0.1-dev}"
NAME="Doors OS"
VERSION_ID="${DOORS_VERSION:-0.1-dev}"
VERSION="${DOORS_VERSION:-0.1-dev} (base Debian ${DEB_VER})"
VERSION_CODENAME=trixie
ID=doors
ID_LIKE=debian
HOME_URL="https://doors-os.invalid/"
EOT
ln -sf ../usr/lib/os-release /etc/os-release
