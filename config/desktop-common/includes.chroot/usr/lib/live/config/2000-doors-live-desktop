#!/bin/sh
# live-config (só roda na sessão live): ícone do instalador e sem bloqueio de tela
. /lib/live/config.sh 2>/dev/null || true
U="${LIVE_USERNAME:-doors}"; H="/home/$U"
[ -d "$H" ] || exit 0
SRC=/usr/share/applications/calamares-install-debian.desktop
if [ -f "$SRC" ]; then
  mkdir -p "$H/Desktop" "$H/Área de trabalho"
  for d in "$H/Desktop" "$H/Área de trabalho"; do
    sed 's/^Name=.*/Name=Instalar Doors OS/; /^Name\[/d' "$SRC" > "$d/instalar-doors.desktop"
    chmod +x "$d/instalar-doors.desktop"
  done
fi
mkdir -p "$H/.config"
printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' > "$H/.config/kscreenlockerrc"
mkdir -p "$H/.config/autostart"
printf '[Desktop Entry]\nType=Application\nName=Doors live: sem bloqueio\nExec=sh -c "gsettings set org.cinnamon.desktop.screensaver lock-enabled false; gsettings set org.cinnamon.desktop.session idle-delay 0; xfconf-query -c xfce4-screensaver -p /lock/enabled -n -t bool -s false"\nNoDisplay=true\n' > "$H/.config/autostart/doors-live-nolock.desktop"
chown -R "$U:$U" "$H/Desktop" "$H/Área de trabalho" "$H/.config" 2>/dev/null || true
