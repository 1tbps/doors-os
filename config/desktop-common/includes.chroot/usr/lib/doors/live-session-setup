#!/bin/sh
# Doors OS — ajustes da sessão LIVE (roda no login gráfico; não faz nada fora da live)
grep -qw 'boot=live' /proc/cmdline || exit 0
# XFCE: marcar como confiável o ícone do instalador (o helper do Debian usa ~/Desktop fixo)
DESK=$(xdg-user-dir DESKTOP 2>/dev/null); F="$DESK/calamares-install-debian.desktop"
for i in $(seq 1 30); do [ -f "$F" ] && break; sleep 1; done
if [ -f "$F" ] && [ "$XDG_CURRENT_DESKTOP" = "XFCE" ]; then
  chmod +x "$F"
  gio set -t string "$F" metadata::trusted true 2>/dev/null || true
  gio set -t string "$F" metadata::xfce-exe-checksum "$(sha256sum "$F" | cut -d' ' -f1)" 2>/dev/null || true
  touch "$F"
fi
exit 0
