#!/bin/sh
# Doors OS — ajustes de sistema SÓ na sessão live (raiz em overlay: nada disso vai para o sistema instalado)
set -e
# KDE: sem bloqueio automático
printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' > /etc/xdg/kscreenlockerrc
# XFCE/LightDM: desativar light-locker e xfce4-screensaver
for f in /etc/xdg/autostart/light-locker.desktop /etc/xdg/autostart/xfce4-screensaver.desktop; do
  [ -f "$f" ] && { grep -q '^Hidden=true' "$f" || echo 'Hidden=true' >> "$f"; }
done
# Cinnamon/GNOME: sem bloqueio
if [ -d /usr/share/glib-2.0/schemas ]; then
  cat > /usr/share/glib-2.0/schemas/99-doors-live.gschema.override <<EOT
[org.cinnamon.desktop.screensaver]
lock-enabled=false
[org.cinnamon.desktop.session]
idle-delay=uint32 0
EOT
  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
fi
# Pastas do usuário live (no idioma da live) + ícone do instalador, ANTES do login gráfico.
# Evita a corrida no autostart entre xdg-user-dirs e o helper do Debian (ícone sumia no KDE).
L=$(sed -n 's/^LANG=//p' /etc/default/locale 2>/dev/null | tr -d '"'); L=${L:-pt_BR.UTF-8}
APP=/usr/share/applications/calamares-install-debian.desktop
for H in /home/*; do
  [ -d "$H" ] || continue
  U=$(stat -c %U "$H"); id "$U" >/dev/null 2>&1 || continue
  runuser -u "$U" -- env HOME="$H" LANG="$L" LC_ALL="$L" xdg-user-dirs-update || true
  D=$(runuser -u "$U" -- env HOME="$H" xdg-user-dir DESKTOP 2>/dev/null || true)
  if [ -n "$D" ] && [ "$D" != "$H" ] && [ -f "$APP" ]; then
    mkdir -p "$D"; cp "$APP" "$D/"; chmod +x "$D/calamares-install-debian.desktop"; chown -R "$U:" "$D"
  fi
done
# ISO única (edição "desktop"): ambiente da live escolhido no menu de boot (doors.ambiente=…; padrão KDE)
if [ -x /usr/lib/doors/escolher-ambiente ] && [ -f /etc/sddm.conf ]; then
  case "$(sed -n 's/.*doors\.ambiente=\([a-z]*\).*/\1/p' /proc/cmdline)" in
    cinnamon) S=cinnamon.desktop ;;
    xfce)     S=xfce.desktop ;;
    gnome)    S=gnome-xorg.desktop ;;
    *)        S=plasmax11.desktop ;;  # X11: acesso remoto (AnyDesk, RustDesk) funciona
  esac
  if grep -q '^Session=' /etc/sddm.conf; then sed -i "s/^Session=.*/Session=$S/" /etc/sddm.conf
  else printf 'Session=%s\n' "$S" >> /etc/sddm.conf; fi
fi
