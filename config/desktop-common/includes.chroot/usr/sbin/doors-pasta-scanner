#!/bin/bash
# Doors OS — pasta compartilhada para a impressora gravar as digitalizações ("digitalizar
# para pasta"), em /home/scanner, compartilhada como \\ESTE-PC\scanner.
#   doors-pasta-scanner            cria ou ajusta (senha da impressora e quem pode abrir)
#   doors-pasta-scanner --remover  desliga o compartilhamento (a pasta e os arquivos ficam)
#
# A impressora entra com um usuário só dela ("impressora"): sem login no computador, sem shell e
# com senha só do Samba. A senha não expira nem depende de nenhuma pessoa.
# Quem abre os arquivos no PC: usuários locais ou do domínio (d123456) e grupos do AD,
# por ACL (setfacl) — usuários do AD não ficam no /etc/passwd, mas têm UID/GID pelo winbind.
set -u

if [ "$(id -u)" != 0 ]; then
  exec pkexec env DISPLAY="${DISPLAY:-}" XAUTHORITY="${XAUTHORITY:-}" "$0" "$@"
fi

PASTA=/home/scanner
CONTA=impressora   # não "scanner": esse grupo já existe (SANE, acesso aos scanners USB)
CONF=/etc/samba/doors-scanner.conf
SMB=/etc/samba/smb.conf
INCLUDE="include = $CONF"
TITULO="Pasta do scanner"
LOG=/var/log/doors-pasta-scanner.log

# ---------- caixas de diálogo (zenity) ou terminal ----------
if [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then GUI=1; else GUI=; fi
# como administrador (pkexec) o desenho por GPU falha no GNOME ("Failed to attach to x11 shm":
# o X roda com o usuário) e a caixa fica vazia; o desenho por software (cairo) funciona em todos
export GSK_RENDERER=cairo
z() { zenity --title="$TITULO" "$@" 2>/dev/null; }
# o zenity interpreta "\" no texto (\n, \t...): dobra as barras para \\PC\pasta aparecer certo
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g'; }
cancelar() { [ -n "$GUI" ] || echo "Cancelado."; exit 1; }
perguntar() {
  local r
  if [ -n "$GUI" ]; then r=$(z --entry --width=480 --text="$(esc "$1")" --entry-text="$2") || cancelar
  else read -r -p "$1 [$2]: " r || cancelar; r=${r:-$2}; fi
  printf '%s' "$r"
}
senha() {
  local r
  if [ -n "$GUI" ]; then r=$(z --entry --hide-text --width=480 --text="$(esc "$1")") || cancelar
  else read -r -s -p "$1: " r || cancelar; echo >&2; fi
  printf '%s' "$r"
}
aviso() { if [ -n "$GUI" ]; then z --info --width=480 --text="$(esc "$1")"; else echo "$1"; fi; }
confirmar() {  # confirmar "texto" "botão de seguir"; Cancelar sai sem mudar nada
  local r
  if [ -n "$GUI" ]; then
    z --question --width=500 --text="$(esc "$1")" --ok-label="$2" --cancel-label="Cancelar" || cancelar
  else
    echo "$1" >&2; read -r -p "$2? [s/N]: " r || cancelar
    case "$r" in s|S|sim|Sim|SIM) ;; *) cancelar ;; esac
  fi
}
falha() {
  echo "ERRO: $1" >>"$LOG"
  if [ -n "$GUI" ]; then z --error --width=480 --text="$(esc "$1

Detalhes em $LOG")"; else echo "ERRO: $1" >&2; fi
  exit 1
}

# quem chamou (pelo menu vem do pkexec, pelo terminal do sudo)
quem_chamou() {
  if [ -n "${PKEXEC_UID:-}" ]; then getent passwd "$PKEXEC_UID" | cut -d: -f1
  else echo "${SUDO_USER:-}"; fi
}

incluir_no_smb_conf() {
  grep -qxF "$INCLUDE" "$SMB" 2>/dev/null || printf '\n# Doors OS: pasta do scanner\n%s\n' "$INCLUDE" >> "$SMB"
}

remover() {
  confirmar "Desligar a pasta do scanner?

• a impressora deixa de conseguir gravar neste computador
• a pasta $PASTA e as digitalizações continuam no disco" "Remover"
  rm -f "$CONF"
  sed -i "\|^# Doors OS: pasta do scanner\$|d; \|^$INCLUDE\$|d" "$SMB"
  smbpasswd -x "$CONTA" >/dev/null 2>&1 || true
  if grep -qiE '^[[:space:]]*security[[:space:]]*=[[:space:]]*ads' "$SMB"; then
    systemctl restart smbd.service 2>/dev/null || true   # no domínio o smbd continua (winbind)
  else
    systemctl disable --now smbd.service 2>/dev/null || true
  fi
  aviso "Pronto: a impressora não grava mais aqui.
A pasta $PASTA e os arquivos continuam."
}

criar() {
  local pc s1="" s2 quem entrada nome id ok="" lista_ok="" avisos="" caminhos="" usuario ip
  : >"$LOG"; chmod 600 "$LOG"

  # --- perguntas (nada muda no computador até a confirmação) ---
  # senha só do Samba (a que vai na impressora)
  local tem_senha=""
  pdbedit -L 2>/dev/null | grep -q "^$CONTA:" && tem_senha=1
  while :; do
    s1=$(senha "Senha que a impressora vai usar (usuário \"$CONTA\")${tem_senha:+
Deixe em branco para manter a senha atual.}")
    if [ -z "$s1" ] && [ -n "$tem_senha" ]; then break; fi
    if [ -z "$s1" ]; then aviso "A senha não pode ficar em branco."; continue; fi
    s2=$(senha "Repita a senha")
    if [ "$s1" != "$s2" ]; then aviso "As senhas não conferem. Tente de novo."; continue; fi
    break
  done
  unset s2

  # quem pode abrir: usuários e grupos (locais ou do AD)
  quem=$(quem_chamou)
  entrada=$(perguntar "Quem pode abrir as digitalizações neste PC?
Usuários ou grupos, separados por vírgula (ex.: d123456, d654321 ou um grupo do domínio)." "$quem")

  confirmar "$([ -f "$CONF" ] && echo "Alterar" || echo "Criar") a pasta do scanner?

• pasta: $PASTA   (na rede: \\\\$(hostname -s | tr 'a-z' 'A-Z')\\scanner)
• usuário da impressora: $CONTA   ($([ -n "$s1" ] && echo "senha nova" || echo "senha atual mantida"))
• podem abrir: ${entrada:-ninguém além da impressora}" "Aceitar"

  # --- aplicar ---
  # usuário só da impressora: sem login, sem shell, sem senha de sistema
  if ! getent passwd "$CONTA" >/dev/null; then
    useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin \
      --comment "Impressora (pasta do scanner)" "$CONTA" >>"$LOG" 2>&1 || falha "Não consegui criar o usuário $CONTA."
  fi
  usermod -L "$CONTA" >>"$LOG" 2>&1 || true
  if [ -n "$s1" ]; then
    printf '%s\n%s\n' "$s1" "$s1" | smbpasswd -a -s "$CONTA" >>"$LOG" 2>&1 || falha "Não consegui definir a senha."
    smbpasswd -e "$CONTA" >>"$LOG" 2>&1
  fi
  unset s1

  mkdir -p "$PASTA"
  chown "$CONTA:$CONTA" "$PASTA"
  chmod 2770 "$PASTA"

  # quem pode abrir, por ACL (refeita do zero: quem saiu da lista perde o acesso)
  setfacl -R -b "$PASTA" 2>>"$LOG" || true
  IFS=',' read -r -a lista <<< "$entrada"
  for nome in "${lista[@]}"; do
    nome=$(echo "$nome" | sed 's/^ *//; s/ *$//')
    nome=${nome##*\\}   # DOMINIO\d123456 -> d123456
    [ -n "$nome" ] || continue
    # ACL pelo número (UID/GID): nomes do AD podem ter espaço ("domain users")
    if id=$(getent passwd "$nome" | cut -d: -f3) && [ -n "$id" ]; then
      setfacl -R -m "u:$id:rwX" "$PASTA"; setfacl -R -d -m "u:$id:rwX" "$PASTA"
      lista_ok="$lista_ok
• $nome"; ok=1
    elif id=$(getent group "$nome" | cut -d: -f3) && [ -n "$id" ]; then
      setfacl -R -m "g:$id:rwX" "$PASTA"; setfacl -R -d -m "g:$id:rwX" "$PASTA"
      lista_ok="$lista_ok
• grupo $nome"; ok=1
    else
      avisos="$avisos
• não encontrei \"$nome\" (confira com: getent passwd $nome)"
    fi
  done
  setfacl -d -m "g:$CONTA:rwX" "$PASTA"

  # 5. compartilhamento (arquivo próprio, incluído no smb.conf; sobrevive ao assistente do domínio)
  cat > "$CONF" <<EOF
# Doors OS (doors-pasta-scanner): pasta da impressora. Gerado — rode o assistente para mudar.
[scanner]
	comment = Digitalizações da impressora
	path = $PASTA
	valid users = $CONTA
	read only = no
	force group = $CONTA
	inherit acls = yes
	create mask = 0660
	directory mask = 2770
EOF
  incluir_no_smb_conf
  testparm -s "$SMB" >>"$LOG" 2>&1 || falha "A configuração do Samba ficou inválida (testparm -s)."

  # 6. atalho "Scanner" na pasta pessoal (novos usuários, inclusive do domínio, e quem chamou)
  [ -e /etc/skel/Scanner ] || ln -s "$PASTA" /etc/skel/Scanner
  if [ -n "$quem" ]; then
    local casa; casa=$(getent passwd "$quem" | cut -d: -f6)
    if [ -n "$casa" ] && [ -d "$casa" ] && [ ! -e "$casa/Scanner" ]; then
      ln -s "$PASTA" "$casa/Scanner" && chown -h "$quem" "$casa/Scanner" 2>/dev/null || true
    fi
  fi

  # 7. liga o Samba (o nmbd não é necessário: a impressora usa o IP ou o nome)
  systemctl enable smbd.service >>"$LOG" 2>&1 || true
  systemctl restart smbd.service >>"$LOG" 2>&1 || falha "O Samba não iniciou (journalctl -u smbd)."
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow Samba >>"$LOG" 2>&1 || true
  fi

  pc=$(hostname -s | tr 'a-z' 'A-Z')
  for ip in $(hostname -I 2>/dev/null); do
    case "$ip" in *:*|172.17.*) ;; *) caminhos="$caminhos
      \\\\$ip\\scanner" ;; esac
  done
  if grep -qiE '^[[:space:]]*security[[:space:]]*=[[:space:]]*ads' "$SMB"; then
    # no domínio: "scanner" com o domínio da empresa vai para o AD, que não conhece a conta
    usuario="$pc\\$CONTA
      (ou só $CONTA, com o campo domínio em branco ou $pc — nunca o domínio da empresa)"
  else
    usuario="$CONTA      (se não aceitar, use $pc\\$CONTA)"
  fi
  aviso "Pronto! Cadastre na impressora (digitalizar para pasta / SMB):

  caminho:$caminhos
      (ou \\\\$pc\\scanner)
  usuário: $usuario
  senha:   a que você acabou de definir

Podem abrir as digitalizações:${lista_ok:-
• ninguém além da impressora (rode de novo para dar acesso)}${avisos:+

Atenção:$avisos}

Os arquivos aparecem em $PASTA (atalho \"Scanner\" na pasta pessoal)."
}

# a pasta já existe: alterar (senha, quem abre), remover ou cancelar
ja_existe() {
  local r usuarios
  usuarios=$(getfacl -p "$PASTA" 2>/dev/null | sed -n 's/^user:\([^:][^:]*\):.*/\1/p' | tr '\n' ' ')
  local t="A pasta do scanner já está ligada neste computador.

• pasta: $PASTA
• usuário da impressora: $CONTA
• podem abrir: ${usuarios:-ninguém além da impressora}

Alterar: trocar a senha da impressora ou quem pode abrir as digitalizações.
Remover: a impressora deixa de gravar aqui (os arquivos continuam)."
  if [ -n "$GUI" ]; then
    r=$(z --question --width=500 --text="$(esc "$t")" --ok-label="Alterar" \
          --cancel-label="Cancelar" --extra-button="Remover")
    case $?:$r in
      0:*) criar ;;
      *:Remover) remover ;;
      *) cancelar ;;
    esac
  else
    echo "$t"; read -r -p "[a]lterar, [r]emover ou [c]ancelar? " r || cancelar
    case "$r" in a|A) criar ;; r|R) remover ;; *) cancelar ;; esac
  fi
}

case "${1:-}" in
  --remover) remover ;;
  "") if [ -f "$CONF" ]; then ja_existe; else criar; fi ;;
  *) echo "uso: $0 [--remover]" >&2; exit 1 ;;
esac
exit 0
