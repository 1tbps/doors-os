# Doors OS — uso corporativo (rede Windows / Active Directory)
# domínio pelo winbind: o assistente "Entrar no domínio" (doors-entrar-dominio) configura e liga
winbind
libnss-winbind
libpam-winbind
samba-common-bin
# testes de DNS do assistente (host)
bind9-host
krb5-user
# pastas compartilhadas: abrir pelo gerenciador de arquivos (smb://) e montar no login (pam_mount)
cifs-utils
keyutils
libpam-mount
smbclient
gvfs-backends
# relógio sincronizado com o servidor do domínio (o Kerberos exige)
systemd-timesyncd
# pasta do scanner: a impressora grava no PC (doors-pasta-scanner); servidor Samba desligado
# até o assistente ser usado; acl para dar acesso a usuários/grupos do AD
samba
acl
# scanner: multifuncionais de rede sem driver (eSCL/WSD) + programa de digitalizar
sane-airscan
simple-scan
# caixas de diálogo dos assistentes (entrar no domínio, pasta do scanner) em qualquer ambiente
zenity
pkexec
# acesso remoto por SSH para manutenção (openssh-server + /etc/ssh/sshd_config.d/10-doors.conf)
doors-ssh
