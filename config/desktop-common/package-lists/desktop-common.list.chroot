# Doors OS — comum a todas as edições gráficas
# instalador
calamares
calamares-settings-debian
# idioma
task-brazilian-portuguese
task-brazilian-portuguese-desktop
chromium-l10n
# áudio / multimídia
pipewire-audio
# fontes
fonts-noto-core
fonts-noto-color-emoji
# aplicações básicas (navegador: Chromium; o Google Chrome pode ser instalado depois pelo .deb do Google)
chromium
# VM (testes em QEMU/KVM)
spice-vdagent
qemu-guest-agent
# detecção de placa NVIDIA (software de terceiros)
pciutils
# capturador de tela (Print Screen no GNOME, Cinnamon e XFCE; no KDE fica o Spectacle)
flameshot
# cópias do sistema (como no Linux Mint): desfazer atualização/configuração que quebrou o sistema
timeshift
# informações do sistema no terminal, com o logo do Doors (config em doors-artwork)
fastfetch
