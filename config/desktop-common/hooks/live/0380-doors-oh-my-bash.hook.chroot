#!/bin/sh
# Oh My Bash (pacote doors-oh-my-bash): confere que o /etc/skel/.bashrc é o do Doors, para o
# usuário live, o criado pelo instalador e os do domínio (pam_mkhomedir) entrarem com ele.
set -e
test -f /usr/share/oh-my-bash/oh-my-bash.sh
grep -q '^export OSH=/usr/share/oh-my-bash$' /etc/skel/.bashrc
test -f /etc/doors-oh-my-bash/bashrc.debian
