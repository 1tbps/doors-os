#!/bin/sh
# Ajustes Doors no Calamares (arquivos do pacote calamares-settings-debian)
set -e
sed -i 's/^branding: .*/branding: doors/' /etc/calamares/settings.conf
# Manter ID EFI "debian": grub assinado (Secure Boot) procura /EFI/debian
grep -q '^efiBootloaderId' /etc/calamares/modules/bootloader.conf || echo 'efiBootloaderId: "debian"' >> /etc/calamares/modules/bootloader.conf
# Atalho do instalador (menu e ícone da área de trabalho criado por add-calamares-desktop-icon)
F=/usr/share/applications/calamares-install-debian.desktop
if [ -f "$F" ]; then
  sed -i 's/^Name=.*/Name=Instalar Doors OS/; /^Name\[/d; s/^Comment=.*/Comment=Instala o Doors OS no computador/; /^Comment\[/d; s/^Icon=.*/Icon=doors-install/' "$F"
fi
gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
systemctl enable doors-live-setup.service
# Bug do Debian: add-calamares-desktop-icon não usa aspas em $DESKTOP ("Área de trabalho" vira 3 pastas)
# e usa ~/Desktop fixo para marcar confiança no XFCE. Corrigir no pacote da live.
H=/usr/bin/add-calamares-desktop-icon
if [ -f "$H" ]; then
  sed -i 's|mkdir -p \$DESKTOP|mkdir -p "$DESKTOP"|; s| \$DESKTOP/calamares-install-debian.desktop| "$DESKTOP/calamares-install-debian.desktop"|g; s|cp /usr/share/applications/calamares-install-debian.desktop \$DESKTOP$|cp /usr/share/applications/calamares-install-debian.desktop "$DESKTOP"|; s|~/Desktop/calamares-install-debian.desktop|"$DESKTOP/calamares-install-debian.desktop"|g; s|): do$|); do|' "$H"
fi
# Disco em btrfs (padrão do particionador): subvolumes @ (raiz) e @home — o formato que o
# Timeshift usa para snapshots —, @swap para o arquivo de troca (o Calamares cria sozinho),
# compressão zstd e noatime. Acrescentado ao mount.conf do Debian (mantém os extraMounts).
M=/etc/calamares/modules/mount.conf
if ! grep -q '^btrfsSubvolumes' "$M"; then
  cat >> "$M" <<'EOF'

# Doors OS
btrfsSubvolumes:
    - mountPoint: /
      subvolume: /@
    - mountPoint: /home
      subvolume: /@home
btrfsSwapSubvol: /@swap
mountOptions:
    - filesystem: default
      options: [ defaults ]
    - filesystem: efi
      options: [ defaults, umask=0077 ]
    - filesystem: btrfs
      options: [ defaults, noatime, compress=zstd:1 ]
    - filesystem: btrfs_swap
      options: [ defaults, noatime ]
EOF
fi
grep -q '^btrfsSubvolumes' "$M" && grep -q 'compress=zstd' "$M"
