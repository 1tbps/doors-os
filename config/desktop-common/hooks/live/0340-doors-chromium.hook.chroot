#!/bin/sh
# Chromium: usar a barra de título e as bordas do sistema (padrão para perfis novos).
# Assim o navegador ganha o contorno arredondado e colorido do Doors em todos os ambientes
# (com a barra própria do Chromium, só os cantos de cima ficam arredondados).
set -e
P=/etc/chromium/master_preferences
[ -f "$P" ] || exit 0
python3 - "$P" <<'PY'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
d.setdefault("browser", {})["custom_chrome_frame"] = False
json.dump(d, open(p, "w"), indent=2, ensure_ascii=False)
PY
grep -q '"custom_chrome_frame": false' "$P"
