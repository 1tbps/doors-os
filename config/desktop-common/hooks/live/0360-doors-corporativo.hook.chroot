#!/bin/sh
# Uso corporativo: os pacotes do winbind vêm instalados, mas desligados até o computador
# entrar num domínio (doors-entrar-dominio liga tudo). Assim nada muda fora de uma empresa.
set -e
sed -i -E '/^(passwd|group|shadow):/s/ winbind//' /etc/nsswitch.conf
pam-auth-update --package --disable winbind
systemctl disable winbind.service 2>/dev/null || true
# servidor Samba: só liga quando a pasta do scanner é criada (doors-pasta-scanner)
systemctl disable smbd.service nmbd.service samba-ad-dc.service 2>/dev/null || true
! grep -qE '^(passwd|group):.*winbind' /etc/nsswitch.conf
! grep -q pam_winbind /etc/pam.d/common-auth
