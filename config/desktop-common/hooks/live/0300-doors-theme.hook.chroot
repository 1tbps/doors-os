#!/bin/sh
# Tema visual Doors OS via mecanismo de temas do desktop-base (Debian)
set -e
T=/usr/share/desktop-base/doors-theme; C=/usr/share/desktop-base/ceratopsian-theme
[ -d "$T" ] || exit 0
if [ -d "$C" ]; then
  for f in wallpaper/gnome-background.xml wallpaper/metadata.json lockscreen/gnome-background.xml lockscreen/metadata.json grub/grub_background.sh; do
    [ -e "$T/$f" ] || { [ -e "$C/$f" ] && sed 's/ceratopsian/doors/g; s/Ceratopsian/Doors OS/g' "$C/$f" > "$T/$f"; }
  done
fi
[ -f "$T/wallpaper/metadata.json" ] && sed -i 's/"Name": "[^"]*"/"Name": "Doors OS"/; s/"Id": "[^"]*"/"Id": "DoorsOS"/' "$T/wallpaper/metadata.json"
update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme "$T" 100
update-alternatives --set desktop-theme "$T"
# XFCE: papel de parede padrão (xfce-x.svg) → Doors
if [ -e /usr/share/backgrounds/xfce/xfce-x.svg ]; then
  dpkg-divert --quiet --local --rename --add /usr/share/backgrounds/xfce/xfce-x.svg
  ln -sf "$T/wallpaper/contents/images/1920x1080.svg" /usr/share/backgrounds/xfce/xfce-x.svg
fi
